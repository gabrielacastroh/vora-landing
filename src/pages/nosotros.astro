---
export const prerender = true;
import '@fontsource-variable/archivo/wght-italic.css';
import Layout from '../layouts/Layout.astro';
import FrameNav from '../components/vora/FrameNav';
import FrameFooter from '../components/vora/FrameFooter';
import Hero from '../components/nosotros/Hero';
import Adn from '../components/nosotros/Adn';
import Band from '../components/nosotros/Band';
import Origin, { originImages, type OriginSets } from '../components/nosotros/Origin';
import { srcSet } from '../lib/srcset';
import heroBg from '../assets/vora/nosotros-hero-bg.webp';
import navBg from '../assets/vora/nav-bg.png';
import { site } from '../data/site';

const originSets: OriginSets = Object.fromEntries(
  await Promise.all(Object.entries(originImages).map(async ([k, img]) => [k, await srcSet(img, [640, 1080, 1920])])),
);
---

<Layout title={site.pages.nosotros.title} description="Conoce a VORA, una marca de moda contemporánea en Colombia: lo que nos mueve y hacia dónde vamos." canvas="#0b0b0d" preloadImage={heroBg.src} italics>
  <div class="relative overflow-x-clip bg-[#0b0b0d]">
    <FrameNav active="nosotros" background={navBg.src} theme="dark" />
    <main>
      <Hero />
      <Adn />
      <Band />
      <Origin sets={originSets} />
    </main>
  </div>
  <FrameFooter />
</Layout>


<style is:global>
  /* Initial state of choreographed steps; only with JS + motion on (same rule as global.css). */
  @media (prefers-reduced-motion: no-preference) {
    .js-motion [data-in] {
      visibility: hidden;
    }
  }
</style>
