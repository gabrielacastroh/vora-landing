---
export const prerender = true;
import '@fontsource/barlow-condensed/700.css';
import Layout from '../layouts/Layout.astro';
import FrameNav from '../components/vora/FrameNav';
import FrameFooter from '../components/vora/FrameFooter';
import Contacto from '../components/contacto/Contacto';
import bg from '../assets/vora/contacto-bg.webp';
import navBg from '../assets/vora/nav-bg.png';
import { site } from '../data/site';
---

<Layout title={site.pages.contacto.title} description="Escríbenos o síguenos en redes: contacta al equipo de VORA Colombia." canvas="#0b0b0d" preloadImage={bg.src}>
  <div class="relative overflow-x-clip bg-[#0b0b0d]">
    <FrameNav active="contacto" background={navBg.src} theme="dark" />
    <main>
      <Contacto />
    </main>
  </div>
  <FrameFooter />
</Layout>

<style is:global>
  /* Initial state of choreographed steps; only with JS + motion on (same rule as /nosotros). */
  @media (prefers-reduced-motion: no-preference) {
    .js-motion [data-in] {
      visibility: hidden;
    }
  }
</style>
