---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import FrameNav from '../../components/vora/FrameNav';
import FrameFooter from '../../components/vora/FrameFooter';
import productNavBg from '../../assets/vora/product-nav-bg.png';
import ProductHero from '../../components/product/ProductHero';
import { getProducts } from '../../data/catalog';
import { site } from '../../data/site';

export async function getStaticPaths() {
  return (await getProducts()).map((p) => ({ params: { slug: p.slug } }));
}

const products = await getProducts();
const i = products.findIndex((p) => p.slug === Astro.params.slug);
if (i < 0) return new Response(null, { status: 404 });
const product = products[i];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: new URL(product.cardImage.src, Astro.site).href,
  brand: { '@type': 'Brand', name: site.name },
});
---

<Layout title={`${product.name} — ${site.name}`} description={product.description}>
  <script type="application/ld+json" set:html={jsonLd} />
  <FrameNav active="coleccion" background={productNavBg.src} theme="dark" />
  <main>
    <ProductHero product={product} />
  </main>
  <FrameFooter />
</Layout>
