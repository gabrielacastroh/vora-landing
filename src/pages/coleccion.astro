---
import Layout from '../layouts/Layout.astro';
import ShopFrame from '../components/shop/ShopFrame';
import FrameFooter from '../components/vora/FrameFooter';
import { getDetails, getLookbook, getProducts } from '../data/catalog';
import { site } from '../data/site';

const [products, looks, details] = await Promise.all([getProducts(), getLookbook(), getDetails()]);
---

<Layout title={site.pages.coleccion.title} canvas="#ece6dd">
  <ShopFrame products={products} looks={looks} details={details} />
  <FrameFooter />
</Layout>
