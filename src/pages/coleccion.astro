---
import Layout from '../layouts/Layout.astro';
import ShopFrame from '../components/shop/ShopFrame';
import FrameFooter from '../components/vora/FrameFooter';
import { getDetails, getLine } from '../data/catalog';
import { site } from '../data/site';

const [unisex, womens, details] = await Promise.all([getLine('unisex'), getLine('womens'), getDetails()]);
---

<Layout title={site.pages.coleccion.title} canvas="#ece6dd">
  <ShopFrame unisex={unisex} womens={womens} details={details} />
  <FrameFooter />
</Layout>
