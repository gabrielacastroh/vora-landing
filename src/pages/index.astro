---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import HomeFrame from '../components/home/HomeFrame';
import FrameFooter from '../components/vora/FrameFooter';
import heroBg from '../assets/vora/hero-couple.webp';
import { getFeatured } from '../data/catalog';
import { site } from '../data/site';
import { jsonLd } from '../lib/jsonld';

const featured = await getFeatured();
const home = new URL('/', Astro.site).href;
// WebSite gives Google the site name; Organization ties the brand to its social profiles.
const structuredData = jsonLd([
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: home },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: home,
    logo: new URL('/apple-touch-icon.png', Astro.site).href,
    sameAs: [site.social.instagram, site.social.tiktok].filter(Boolean),
  },
]);
---

<Layout
  title={site.pages.home.title}
  description={site.description}
  ogTitle={site.pages.home.title}
  ogDescription={site.description}
  preloadImage={heroBg.src}
>
  <script is:inline type="application/ld+json" set:html={structuredData} />
  <HomeFrame featured={featured} />
  <FrameFooter />
</Layout>
