---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import HomeFrame from '../components/home/HomeFrame';
import FrameFooter from '../components/vora/FrameFooter';
import heroBg from '../assets/vora/hero-couple.webp';
import { getFeatured } from '../data/catalog';
import { site } from '../data/site';

const featured = await getFeatured();
---

<Layout
  title={site.pages.home.title}
  description={site.description}
  ogTitle={site.pages.home.title}
  ogDescription={site.description}
  preloadImage={heroBg.src}
>
  <HomeFrame featured={featured} />
  <FrameFooter />
</Layout>
