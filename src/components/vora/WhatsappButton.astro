---
import { generalWhatsapp } from '../../lib/whatsapp';
import icon from '../../assets/vora/contacto-whatsapp.webp';

interface Props {
  /** Cream page canvas (collection, legal): the pill borrows the page's colors instead of clashing with them. */
  light?: boolean;
}

// Site-wide shortcut to the brand chat. Hidden when the number isn't set; product pages hide it
// (their own "Comprar por WhatsApp" button already sits in the same corner).
const href = generalWhatsapp();
const { light = false } = Astro.props;
// Same language as the product buy button: translucent fill, thin red outline, red type, soft red glow.
const tone = light
  ? 'border-[#5c141a]/70 bg-[#ece6dd]/85 text-[#5c141a] shadow-[0_0.5rem_1.5rem_rgb(92_20_26/0.18)] hover:shadow-[0_0.5rem_2rem_rgb(92_20_26/0.32)]'
  : 'border-vora-red-bright/80 bg-[#0b0b0d]/70 text-vora-red-bright shadow-[0_0_2rem_rgb(163_43_50/0.22)] hover:shadow-[0_0_2.5rem_rgb(163_43_50/0.45)]';
---

{
  href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
      data-wa-fab
      class={`group fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-20 flex h-11 items-center gap-2 rounded-full border-[1.5px] pr-4 pl-3 font-mont text-xs font-bold tracking-wide uppercase backdrop-blur-md transition-[box-shadow,transform] duration-500 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current sm:right-6 sm:bottom-[max(1.5rem,env(safe-area-inset-bottom))] sm:h-12 sm:gap-2.5 sm:pr-5 sm:pl-3.5 sm:text-[0.8125rem] motion-reduce:transition-none ${tone}`}
      style="view-transition-name: wa-fab"
    >
      <img alt="" src={icon.src} width={icon.width} height={icon.height} class="size-5 max-w-none object-contain sm:size-6" />
      Escríbenos
    </a>
  )
}
