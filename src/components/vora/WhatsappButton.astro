---
import { site } from '../../data/site';
import icon from '../../assets/vora/footer-social-3.png';

// Site-wide shortcut to the brand chat. Hidden when the number isn't set; product pages hide it
// (their own "Comprar por WhatsApp" button already sits in the same corner).
const href = site.social.whatsapp;
---

{
  href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
      data-wa-fab
      class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-20 flex size-14 items-center justify-center rounded-full bg-[#5c141a] shadow-[0_0.5rem_1.5rem_rgb(0_0_0/0.35)] ring-1 ring-white/25 transition-[transform,background-color] duration-300 hover:scale-110 hover:bg-[#7a1a22] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-6 sm:bottom-[max(1.5rem,env(safe-area-inset-bottom))] sm:size-16 motion-reduce:transition-none"
      style="view-transition-name: wa-fab"
    >
      <img alt="" src={icon.src} width={icon.width} height={icon.height} class="size-7 max-w-none object-contain sm:size-8" />
    </a>
  )
}
