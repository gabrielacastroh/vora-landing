---
import '../styles/global.css';
import { site } from '../data/site';
import WhatsappButton from '../components/vora/WhatsappButton.astro';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import archivoItalicLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-italic.woff2?url';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import montserratItalicLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-italic.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Page canvas color. View Transitions expose it behind the animating pages, so it
   *  must match the page or navigation flashes the default dark canvas. */
  canvas?: string;
  /** Above-the-fold image to fetch before the CSS/JS discovers it (the LCP element). */
  preloadImage?: string;
  /** Keep private pages out of search results. */
  noindex?: boolean;
  /** The first paint uses the italic faces (nosotros hero): preload them, since motion waits on document.fonts.ready. */
  italics?: boolean;
  /** Hide the floating WhatsApp shortcut (product pages have their own buy button). */
  hideWhatsapp?: boolean;
  /** Social-share overrides; default to title/description. */
  ogTitle?: string;
  ogDescription?: string;
  /** Share image path or absolute URL (1200x630). */
  image?: string;
}

const { title, description = site.description, canvas = '#0b0b0d', preloadImage, noindex, italics, hideWhatsapp = false, ogTitle = title, ogDescription = description, image = '/og-image.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="es-CO" style={`background-color: ${canvas}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VORA" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VORA Colombia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    {
      italics && (
        <>
          <link rel="preload" href={montserratItalicLatin} as="font" type="font/woff2" crossorigin />
          <link rel="preload" href={archivoItalicLatin} as="font" type="font/woff2" crossorigin />
        </>
      )
    }
    {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}
    <title>{title}</title>
    <script is:inline>
      (() => {
        const html = document.documentElement;
        // Product → product (prev/next): same layout, so swap content in place instead of
        // replaying the page wipe and the text intros, which reads as a flicker.
        const path = (url) => new URL(url).pathname;
        const isProduct = (url) => !!url && path(url).startsWith('/producto/');
        // The nav only stays pinned across pages with the same theme; between dark and light
        // it must travel with the page, or the old nav lingers as a dark band over the new one.
        const navTheme = (url) => (path(url).startsWith('/coleccion') || path(url).startsWith('/politica-de-privacidad') ? 'light' : 'dark');
        const unpinNav = () => document.querySelector('[data-nav]')?.style.setProperty('view-transition-name', 'none');
        addEventListener('pageswap', (e) => {
          const to = e.activation?.entry?.url;
          if (e.viewTransition && to && navTheme(to) !== navTheme(location.href)) unpinNav();
        });
        addEventListener('pagereveal', (e) => {
          const from = window.navigation?.activation?.from?.url;
          if (e.viewTransition && from && navTheme(from) !== navTheme(location.href)) {
            unpinNav();
            // Dark ↔ light: a solid curtain instead of a crossfade, so the two palettes never blend.
            e.viewTransition.types.add('theme-change');
          }
        });
        const swap = isProduct(window.navigation?.activation?.from?.url) && isProduct(location.href);
        if (swap) {
          html.dataset.swap = '';
          // Set by the prev/next arrows; back/forward history defaults to "next".
          let dir = 'next';
          try {
            dir = sessionStorage.getItem('vora-dir') || dir;
            sessionStorage.removeItem('vora-dir');
          } catch {}
          addEventListener(
            'pagereveal',
            (e) => {
              // types is Set-like: add() takes one value at a time.
              e.viewTransition?.types.add('product-swap');
              e.viewTransition?.types.add(`swap-${dir}`);
            },
            { once: true },
          );
        }
        // Hide animated elements before first paint. If the motion bundle never starts (blocked,
        // failed or stale), reveal everything as soon as the page has loaded, with a hard cap.
        if (!swap && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          html.classList.add('js-motion');
          const reveal = () => window.__voraMotion || html.classList.remove('js-motion');
          addEventListener('load', () => setTimeout(reveal, 300), { once: true });
          setTimeout(reveal, 3000);
        }
      })();
    </script>
  </head>
  <body class="bg-vora-bg font-sans antialiased">
    <slot />
    {!hideWhatsapp && <WhatsappButton />}
    <script>
      import '../scripts/motion';
      // Firefox ignores -webkit-user-drag.
      document.addEventListener('dragstart', (e) => {
        if (e.target instanceof HTMLImageElement) e.preventDefault();
      });
    </script>
  </body>
</html>
